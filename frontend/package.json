{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "prepare": "husky",
    "dev": "vite",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest run",
    "check:translations": "node ../scripts/check-translations.js",
    "sort:translations": "node ../scripts/sort-translations.js",
    "test:watch": "vitest"
  },
  "dependencies": {
    "i18next": "^25.8.7",
    "i18next-browser-languagedetector": "^8.2.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.5.4"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "autoprefixer": "^10.4.24",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.0.11",
    "lint-staged": "^15.2.7",
    "globals": "^16.5.0",
    "jsdom": "^24.1.0",
    "postcss": "^8.5.6",
    "prettier": "^3.3.2",
    "tailwindcss": "^3.4.13",
    "vite": "^7.3.1",
    "vitest": "^2.0.1"
  },
  "lint-staged": {
    "src/**/*.{js,jsx}": [
      "prettier --write",
      "eslint --fix",
      "vitest run --related"
    ],
    "src/**/*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
